{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mediaar",
  "version": "0.1.0",
  "identifier": "com.mediaar.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mediaar",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
