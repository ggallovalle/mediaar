   Compiling mediaar v0.1.0 (/home/kbroom/Projects/mediaar/crates/mediaar)
    Finished `dev` profile [unoptimized + debuginfo] target(s) in 7.93s
     Running `target/debug/mediaar __usage_spec__`
name Mediaar
bin mediaar
version "0.1.0"
about "Manage your media"
subcommand_required #true
flag --lang help="UI language (e.g. en, es). Overrides the persisted toggle and system locale." global=#true {
    arg <LANG>
}
flag "-h --help" help="Print help" action=help builtin=#true
flag "-V --version" help="Print version" action=version builtin=#true
cmd desktop help="Start the desktop app" {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd tui help="Start the tui app" {
    flag "-h --help" help="Print help" action=help builtin=#true
}
config {
    file "$XDG_CONFIG_DIRS/mediaar/config.toml" scope="system" format="toml"
    file "$XDG_CONFIG_HOME/mediaar/config.toml" scope="global" format="toml"
    prop "lang" type="string" default_note="from LANG / system, else en" optional=#true help="UI language (e.g. en, es)" {
        cli "--lang"
    }
}
